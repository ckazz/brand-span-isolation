# Only needed for `--mode live`. The default inspect mode needs none of this.
# Copy to .env and fill in, then:  set -a; source .env; set +a

# Your Galileo console URL, e.g. https://console.galileo.yourcompany.com
GALILEO_CONSOLE_URL=

# An API key from that deployment (Settings -> API Keys).
GALILEO_API_KEY=

# Project and log stream these traces should be written to. Both are created on
# first ingest if they do not exist. Use a throwaway log stream: this writes
# synthetic conversations and you probably do not want them in a real stream.
GALILEO_PROJECT=brand-span-isolation
GALILEO_LOG_STREAM=turn-io-synthesis
